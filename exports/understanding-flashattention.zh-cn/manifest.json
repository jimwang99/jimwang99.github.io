  "quoteParagraphs": [
    {
      "kind": "author",
      "fill": "FFF4CC",
      "text": "笔者：这种做法让我想起了 dynamic programming。"
    },
    {
      "kind": "warning",
      "fill": "FDE9E7",
      "text": "注意：在 LLM 里，batch_size 和 num_head 这两个维度只是在重复独立的 attention 计算。对其中每一个计算来说，N 和 M 取决于序列长度，是运行时才知道的动态变量（runtime dynamic variable）；D 是 head_dim，编译时就确定了（compile-time static variable）。这一点对性能优化非常重要。"
    },
    {
      "kind": "author",
      "fill": "FFF4CC",
      "text": "笔者：整个推导的核心只有一个思路：只要最终结果正确，中间结果可以换一种含义。Online softmax 用它处理分母，FlashAttention 再把它用到输出上。"
    }
  ],
  "assets": [
    {
      "id": "asset-001",
      "file": "assets/asset-001.png",
      "kind": "display-math",
      "source": " \\mathrm{softmax}(\\vec{x})_i = \\frac{e^{x_i}}{\\sum_{j=1}^{N} e^{x_j}} ",
      "width": 184.4375,
      "height": 64.0625,
      "displayScale": 1
    },
    {
      "id": "asset-002",
      "file": "assets/asset-002.png",
      "kind": "display-math",
      "source": " \\mathrm{softmax}(\\vec{x})_i = \\frac{e^{x_i - \\max(\\vec{x})}}{\\sum_{j=1}^{N} e^{x_j - \\max(\\vec{x})}} ",
      "width": 230.921875,
      "height": 67.78125,
      "displayScale": 1
    },
    {
      "id": "asset-003",
      "file": "assets/asset-003.png",
      "kind": "code-block",
      "source": "import math\nimport random\n\nN = 8\nvec_x = [random.random() for _ in range(N)]\n# 1st pass\nmax_x = max(vec_x)\n# 2nd pass\nsum_ex = sum(math.exp(x - max_x) for x in vec_x)\n# 3rd pass\nsoftmax_x = [math.exp(x - max_x) / sum_ex for x in vec_x]",
      "width": 640,
      "height": 259,
      "displayScale": 1
    },
    {
      "id": "asset-004",
      "file": "assets/asset-004.png",
      "kind": "display-math",
      "source": " g_i = \\max(x_1, \\dots, x_i), \\qquad\ns_i = \\sum_{j=1}^{i} e^{x_j - g_i} ",
      "width": 299.25,
      "height": 73.65625,
      "displayScale": 1
    },
    {
      "id": "asset-005",
      "file": "assets/asset-005.png",
      "kind": "display-math",
      "source": " \\begin{aligned}\ns_1 &= 1, \\\\\ns_i &= s_{i-1} \\times e^{g_{i-1} - g_i} + e^{x_i - g_i}.\n\\end{aligned} ",
      "width": 205.640625,
      "height": 69.90625,
      "displayScale": 1
    },
    {
      "id": "asset-006",
      "file": "assets/asset-006.png",
      "kind": "display-math",
      "source": " \\begin{aligned}\ns_i &= e^{g_{i-1} - g_i} \\sum_{j=1}^{i-1} e^{x_j - g_{i-1}} + e^{x_i - g_i} \\\\\n&= \\sum_{j=1}^{i-1} e^{x_j - g_i} + e^{x_i - g_i} \\\\\n&= \\sum_{j=1}^{i} e^{x_j - g_i}.\n\\end{aligned} ",
      "width": 229.859375,
      "height": 195.984375,
      "displayScale": 1
    },
    {
      "id": "asset-007",
      "file": "assets/asset-007.png",
      "kind": "code-block",
      "source": "s_prev = 1.0  # s_{i-1}\ng_prev = vec_x[0]  # g_{i-1}\nfor i in range(1, N):  # starting from the 2nd element\n    x = vec_x[i]  # read x\n    g = max(g_prev, x)  # g_i\n    s = s_prev * math.exp(g_prev - g) + math.exp(x - g)  # s_i\n    s_prev, g_prev = s, g  # save as s_{i-1} and g_{i-1}\n\nassert g_prev == max_x and math.isclose(s_prev, sum_ex)",
      "width": 640,
      "height": 217,
      "displayScale": 1
    },
    {
      "id": "asset-008",
      "file": "assets/asset-008.png",
      "kind": "display-math",
      "source": " \\mathbb{A} = \\mathrm{softmax}\\left(\\mathrm{mask}\\left(\\frac{\\mathbb{Q} \\cdot \\mathbb{K}^T}{\\sqrt{D}}\\right)\\right) \\cdot \\mathbb{V} ",
      "width": 270.84375,
      "height": 61.0625,
      "displayScale": 1
    },
    {
      "id": "asset-009",
      "file": "assets/asset-009.png",
      "kind": "display-math",
      "source": " \\mathrm{softmax}(\\mathbb{Q} \\cdot \\mathbb{K}^T) \\cdot \\mathbb{V} = \\mathrm{softmax}(\\mathbb{X}) \\cdot \\mathbb{V} = \\mathbb{Y} \\cdot \\mathbb{V} = \\mathbb{A} ",
      "width": 374.609375,
      "height": 40.796875,
      "displayScale": 1
    },
    {
      "id": "asset-010",
      "file": "assets/asset-010.png",
      "kind": "display-math",
      "source": " x_{n,m} = \\mathbb{X}[n,m] = \\mathbb{Q}[n,:] \\cdot \\mathbb{K}^T[:,m] ",
      "width": 256.765625,
      "height": 41.796875,
      "displayScale": 1
    },
    {
      "id": "asset-011",
      "file": "assets/asset-011.png",
      "kind": "display-math",
      "source": " \\begin{aligned}\nx_m &= \\mathbb{Q}[n,:] \\cdot \\mathbb{K}^T[:,m], \\\\\ng_m &= \\max(g_{m-1}, x_m), \\\\\ns_m &= s_{m-1} \\times e^{g_{m-1} - g_m} + e^{x_m - g_m}.\n\\end{aligned} ",
      "width": 235.71875,
      "height": 95.71875,
      "displayScale": 1
    },
    {
      "id": "asset-012",
      "file": "assets/asset-012.png",
      "kind": "display-math",
      "source": " \\begin{aligned}\ny_m &= \\frac{e^{x_m - g_M}}{s_M}, \\\\\n\\vec{A}_0 &= \\vec{0}, \\\\\n\\vec{A}_m &= \\vec{A}_{m-1} + y_m \\times \\mathbb{V}[m,:].\n\\end{aligned} ",
      "width": 210.484375,
      "height": 117.125,
      "displayScale": 1
    },
    {
      "id": "asset-013",
      "file": "assets/asset-013.png",
      "kind": "display-math",
      "source": " \\mathbb{A}[n,d] = \\mathbb{Y}[n,:] \\cdot \\mathbb{V}[:,d] = \\sum_{m=1}^{M} \\mathbb{Y}[n,m] \\times \\mathbb{V}[m,d] ",
      "width": 356.390625,
      "height": 71.5,
      "displayScale": 1
    },
    {
      "id": "asset-014",
