    {
      "id": "asset-032",
      "file": "assets/asset-032.png",
      "kind": "code-block",
      "source": "s_prev = 1.0  # s_{i-1}\ng_prev = vec_x[0]  # g_{i-1}\nfor i in range(1, N):  # starting from the 2nd element\n    x = vec_x[i]  # read x\n    g = max(g_prev, x)  # g_i\n    s = s_prev * math.exp(g_prev - g) + math.exp(x - g)  # s_i\n    s_prev, g_prev = s, g  # save as s_{i-1} and g_{i-1}\n\nassert g_prev == max_x and math.isclose(s_prev, sum_ex)",
      "width": 640,
      "height": 217,
      "depth": 0,
      "displayScale": 1
